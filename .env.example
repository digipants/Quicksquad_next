# Gmail account used by the server-side email routes.
# Use a Gmail App Password, not your normal account password.
EMAIL_USER=your-gmail-address@example.com
EMAIL_PASS=your-16-character-gmail-app-password

# Optional: a verified sender address. Defaults to EMAIL_USER when omitted.
EMAIL_FROM=your-gmail-address@example.com

# Inbox for contact-form notifications (subscriber notifications retain their existing inbox).
# Contact notifications default to EMAIL_USER when omitted.
# Keep the current verified inbox; do not use an unverified resolve-us.com mailbox.
# CONTACT_INBOX=your-existing-inbox@example.com

# Optional: reCAPTCHA is not required by the current contact form.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Existing server-only integrations; retain production values in Netlify.
# OPENAI_API_KEY=
# MONGODB_URI=
# ADMIN_PASSWORD=
